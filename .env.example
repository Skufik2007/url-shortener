# Скопируйте этот файл в .env и при необходимости поправьте значения.
# .env не коммитится (см. .gitignore). Docker Compose читает .env автоматически
# (для подстановки AUTH_SECRET); для запуска через `make run` файл читается Makefile.

# Адрес, на котором слушает HTTP-сервер.
HTTP_ADDR=:8080

# Публичный базовый URL, из которого строятся короткие ссылки (short_url).
BASE_URL=http://localhost:8080

# Строка подключения к PostgreSQL. Пусто -> хранение в памяти (без персистентности).
# Пример: postgres://shortener:shortener@localhost:5432/shortener?sslmode=disable
DATABASE_URL=

# Строка подключения к Redis (кэш ссылок и счётчики). Пусто -> кэш в памяти.
# Пример: redis://localhost:6379/0
REDIS_URL=

# Секрет для подписи токенов HMAC-SHA256. Обязателен, если задан DATABASE_URL.
# Используйте длинную случайную строку, например: openssl rand -hex 32
AUTH_SECRET=

# Срок жизни токена авторизации (формат time.ParseDuration).
TOKEN_TTL=72h

# Путь к базе MaxMind GeoLite2 (.mmdb) для определения страны. Пусто -> страна ZZ,
# если нет CountryHint из заголовка. Сам файл в репозиторий не кладётся.
GEOIP_DB=

# Доверять заголовкам X-Forwarded-For / X-Real-IP (включайте только за обратным прокси).
TRUST_PROXY=false

# Длина автоматически генерируемого короткого кода.
CODE_LENGTH=7

# Аналитика: число воркеров, размер буфера канала событий, размер пакета записи,
# интервал принудительного сброса пакета.
ANALYTICS_WORKERS=4
ANALYTICS_BUFFER=10000
ANALYTICS_BATCH=500
ANALYTICS_FLUSH=1s

# Ограничение частоты запросов (token bucket по IP) для POST /links и /auth/*.
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20

# Уровень логирования log/slog: debug | info | warn | error.
LOG_LEVEL=info

# Только для интеграционных тестов (make test-integration, CI): строка подключения к тестовой БД.
# TEST_DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener?sslmode=disable
